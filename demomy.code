public class Demo {

    private double num;

    public Demo() {
        num = 1;
    }

    public double findRemainder(int num, int divisor) {
        double factorial = 1;

        for(int i = 1; i <= num; ++i){
            factorial *= i;
        }

        return factorial;
    }


    public double factorial(int num){
        double remainder = 0;

        if(num != 0) {
            double remainder = num % divisor;
        }

        return remainder;
    }
}
