public class Demo {

    private double num;

    public Demo() {
        num = 1;
    }

    public double findRemainder(int num, int divisor) {
    double remainder = 0;

    if(num != 0) {
        remainder = num % divisor;
    }

    return remainder;
}

public double factorial(int num) {
    double factorial = 1;

    for(int i = 1; i <= num; ++i) {
        factorial *= i;
    }

    return factorial;
}
}
